# Copy this file to .env and fill in the values from the Lean dashboard:
# Development -> Integration settings.
# Never commit .env and never paste these values into a chat.

# "App token" (it is also the Application ID used as client_id).
LEAN_APP_TOKEN=

# "Client secret". Careful: Lean shows it once; revealing it again creates a new one.
LEAN_CLIENT_SECRET=
